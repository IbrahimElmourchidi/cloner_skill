#!/usr/bin/env sh
# clone-site — convenience wrapper for the generator.
#
#   clone-site init <project> --name "My Project"   scaffold a site
#   clone-site scan <project>                       inventory + draft step order
#   clone-site help
#
# This exists for discoverability, not capability. Every subcommand is a
# one-line exec of a script under scripts/, and running those directly works
# exactly the same:
#
#   python3 scripts/bootstrap.py <project> --name "My Project"
#
# It adds two things worth the thirty lines: a stable name to type, and a
# Python-not-installed error that says what to do about it instead of
# "command not found".
#
# POSIX sh, no dependencies. Written for /bin/sh rather than bash because macOS
# ships bash 3 and a bash script would work on Linux and break on half the
# machines that matter.

set -u

# Resolve the skill root — the directory *above* bin/ — following symlinks.
# `readlink -f` is GNU-only and absent on older macOS, so this walks the link
# chain with portable readlink. `${self%/*}` rather than `dirname`: pure
# parameter expansion, so it costs no fork and still works when coreutils is
# not on PATH.
self=$0
while [ -L "$self" ]; do
    link=$(readlink "$self") || break
    case $link in
        /*) self=$link ;;
        *)  case $self in */*) self=${self%/*}/$link ;; *) self=$link ;; esac ;;
    esac
done
case $self in
    */*) bin_dir=${self%/*} ;;
    *)   bin_dir=. ;;                     # invoked bare from PATH
esac
ROOT=$(cd "$bin_dir/.." && pwd -P)

die() {
    printf 'clone-site: %s\n' "$1" >&2
    exit 1
}

usage() {
    cat <<'EOF'
clone-site — turn a repository into a step-by-step teaching site

  clone-site init <project> [options]   Scaffold a site for a repository
  clone-site scan <project> [options]   Inventory a repo, draft a step order
  clone-site help                       This message

init
  <project>           Path to the repository being documented
  -n, --name <name>   Display name. Default: the directory name.
  -o, --out <path>    Where to write the site. Default: docs/site
  -f, --force         Overwrite an existing scaffold

scan
  <project>           Path to the repository to inventory
      --json          Machine-readable report
      --write         Emit a pages.py-shaped draft step order
      --skip <dir>    Replace the built-in skip list (repeatable)
      --include <dir> Re-enable a directory skipped by default (repeatable)

Building, indexing and validating run inside the generated site, in
docs/site/_build/. See SKILL.md for the full picture.
EOF
}

PY=
for candidate in python3 python; do
    if command -v "$candidate" >/dev/null 2>&1 &&
       "$candidate" --version >/dev/null 2>&1; then
        PY=$candidate
        break
    fi
done

# run <script-name> <args...>  — exec the named script, forwarding our exit code.
run() {
    name=$1
    shift
    script=$ROOT/scripts/$name
    [ -f "$script" ] || die "missing scripts/$name — is this an incomplete checkout?"
    if [ -z "$PY" ]; then
        die "python3 not found on PATH.
  The generator is Python 3, standard library only — nothing to pip install.
  macOS:       brew install python3
  Debian/Ubuntu: apt install python3
  Windows:     install from python.org and tick \"Add to PATH\"."
    fi
    "$PY" "$script" "$@"
    exit $?
}

cmd=${1:-help}
[ $# -gt 0 ] && shift

case $cmd in
    init)          run bootstrap.py "$@" ;;
    scan)          run scan.py "$@" ;;
    help|-h|--help) usage ;;
    -v|--version)  printf 'cloner_skill (git)\n' ;;
    *)             die "unknown command: $cmd  (try: clone-site help)" ;;
esac