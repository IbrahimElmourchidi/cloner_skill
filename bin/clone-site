#!/usr/bin/env sh
# clone-site — convenience wrapper for the generator.
#
#   clone-site init <project> --name "My Project"   scaffold a site
#   clone-site scan <project>                       inventory + draft step order
#   clone-site render [site]                        re-render + validate, no edits
#   clone-site sync [site]                          compare site against the repo
#   clone-site help
#
# This exists for discoverability, not capability. Every subcommand is a
# one-line exec of a script under scripts/, and running those directly works
# exactly the same:
#
#   python3 scripts/bootstrap.py <project> --name "My Project"
#
# It adds two things worth the thirty lines: a stable name to type, and a
# Python-not-installed error that says what to do about it instead of
# "command not found".
#
# POSIX sh, no dependencies. Written for /bin/sh rather than bash because macOS
# ships bash 3 and a bash script would work on Linux and break on half the
# machines that matter.

set -u

# Resolve the skill root — the directory *above* bin/ — following symlinks.
# `readlink -f` is GNU-only and absent on older macOS, so this walks the link
# chain with portable readlink. `${self%/*}` rather than `dirname`: pure
# parameter expansion, so it costs no fork and still works when coreutils is
# not on PATH.
self=$0
while [ -L "$self" ]; do
    link=$(readlink "$self") || break
    case $link in
        /*) self=$link ;;
        *)  case $self in */*) self=${self%/*}/$link ;; *) self=$link ;; esac ;;
    esac
done
case $self in
    */*) bin_dir=${self%/*} ;;
    *)   bin_dir=. ;;                     # invoked bare from PATH
esac
ROOT=$(cd "$bin_dir/.." && pwd -P)

die() {
    printf 'clone-site: %s\n' "$1" >&2
    exit 1
}

usage() {
    cat <<'EOF'
clone-site — turn a repository into a step-by-step teaching site

  clone-site init <project> [options]   Scaffold a site for a repository
  clone-site scan <project> [options]   Inventory a repo, draft a step order
  clone-site render [site]              Re-render and validate, changing nothing
  clone-site sync [site] [options]      Compare the site against the repository
  clone-site help                       This message

init
  <project>           Path to the repository being documented
  -n, --name <name>   Display name. Default: the directory name.
  -o, --out <path>    Where to write the site. Default: docs/site
  -f, --force         Overwrite an existing scaffold

scan
  <project>           Path to the repository to inventory
      --json          Machine-readable report
      --write         Emit a pages.py-shaped draft step order
      --skip <dir>    Replace the built-in skip list (repeatable)
      --include <dir> Re-enable a directory skipped by default (repeatable)
      --no-deps       Keep the directory/size order; skip the import-graph sort

render
  <site>             Path to the generated site. Default: docs/site

sync
  <site>             Path to the generated site. Default: docs/site
      --root <path>  Repository to compare against. Default: config source_root
      --apply        Act on the safe cases, not just report them
      --yes          Do not stop to ask before deleting

sync is a dry run by default and changes nothing until --apply. It reports five
cases: added, modified, renamed, deleted, orphaned. It removes a lesson whose
file is gone AND whose contents are absent from the repository; it refuses to
touch one it cannot prove, because a misconfigured --root that auto-deleted on
an inference would take half the lessons with it.

render is idempotent and touches nothing under _build/content/. It is the
right command after a hand-edit, after a split, or on someone else's site.

See SKILL.md for the full picture.
EOF
}

PY=
for candidate in python3 python; do
    if command -v "$candidate" >/dev/null 2>&1 &&
       "$candidate" --version >/dev/null 2>&1; then
        PY=$candidate
        break
    fi
done

# run <script-name> <args...>  — exec the named script, forwarding our exit code.
run() {
    name=$1
    shift
    script=$ROOT/scripts/$name
    [ -f "$script" ] || die "missing scripts/$name — is this an incomplete checkout?"
    [ -z "$PY" ] && need_python
    "$PY" "$script" "$@"
    exit $?
}

# render [site]  — build + index + both validators, inside the site's own _build.
#
# Deliberately runs the *site's* copies of the scripts rather than this skill's.
# Once a site exists it owns its generator, and that is what lets it be updated
# by copying newer files over it without touching the installed skill at all.
render() {
    site=${1:-docs/site}
    build_dir=$site/_build
    [ -d "$build_dir" ] || die "no site at $site — run: clone-site init <project>"
    [ -z "$PY" ] && need_python
    for s in build.py index.py check_site.py check_svg.py; do
        [ -f "$build_dir/$s" ] || die "$site/_build/$s is missing — is this an incomplete site?"
    done
    cd "$build_dir" || die "cannot enter $build_dir"
    "$PY" build.py && "$PY" index.py || die "render failed"
    "$PY" check_site.py && "$PY" check_svg.py || die "validation failed — not rendering clean"
}

need_python() {
    die "python3 not found on PATH.
  The generator is Python 3, standard library only — nothing to pip install.
  macOS:       brew install python3
  Debian/Ubuntu: apt install python3
  Windows:     install from python.org and tick \"Add to PATH\"."
}

# sync [site] -- compare the site's manifest against the repository.
#
# Runs the SITE's copy, not the skill's, for the same reason render does: once
# a site exists it owns its generator. That is also what lets sync.py stay
# generic — it holds no project names and is updated by copying over the top.
sync() {
    site=${1:-docs/site}
    shift 2>/dev/null || true
    build_dir=$site/_build
    [ -d "$build_dir" ] || die "no site at $site — run: clone-site init <project>"
    [ -z "$PY" ] && need_python
    [ -f "$build_dir/sync.py" ] || die "$build_dir/sync.py is missing — copy a newer generator over the site (clone-site init <project> --force)"
    cd "$build_dir" || die "cannot enter $build_dir"
    "$PY" sync.py "$@"
    exit $?
}

cmd=${1:-help}
[ $# -gt 0 ] && shift

case $cmd in
    init)          run bootstrap.py "$@" ;;
    scan)          run scan.py "$@" ;;
    render)        render "$@" ;;
    sync)          sync "$@" ;;
    help|-h|--help) usage ;;
    -v|--version)  printf 'cloner_skill (git)\n' ;;
    *)             die "unknown command: $cmd  (try: clone-site help)" ;;
esac